{
  "name": "signalk-noaa-sonar-charts",
  "version": "1.1.1",
  "description": "NOAA high-resolution underwater relief charts (NOAA sonar + BlueTopo bathymetry/relief) for Signal K / Freeboard. Renders missing tiles on demand into an MBTiles cache and masks out land.",
  "main": "plugin/index.js",
  "bin": {
    "noaa-sonar-charts": "tools/noaa-sonar-to-mbtiles.js"
  },
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "build-land-db": "node tools/build-land-db.js",
    "prepare": "tsc"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk-category-chart-plotters",
    "signalk",
    "chart",
    "noaa",
    "bluetopo",
    "bathymetry",
    "sonar",
    "mbtiles"
  ],
  "signalk": {
    "displayName": "NOAA Sonar Charts",
    "screenshots": [
      "./docs/screenshots/noaa-sonar-charts-screenshot.jpg"
    ]
  },
  "files": [
    "plugin",
    "tools",
    "README.md",
    "CHANGELOG.md",
    "AGENTS.md",
    "CLAUDE.md",
    "LICENSE",
    "docs/screenshots"
  ],
  "author": "Joel Kozikowski",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/joelkoz/signalk-noaa-sonar-charts.git"
  },
  "bugs": {
    "url": "https://github.com/joelkoz/signalk-noaa-sonar-charts/issues"
  },
  "homepage": "https://github.com/joelkoz/signalk-noaa-sonar-charts#readme",
  "engines": {
    "node": ">=22.5.0"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "sharp": "^0.34.0",
    "shapefile": "^0.6.6"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.10.1",
    "@types/adm-zip": "^0.5.7",
    "@types/express": "^4.17.21",
    "@types/node": "^24.0.0",
    "typescript": "^5.4.0"
  }
}
