{
  "name": "signalk-noaa-sonar",
  "version": "0.2.0",
  "description": "NOAA underwater relief charts for Signal K / Freeboard: serves NOAA sonar (BAG hillshade) and BlueTopo bathymetry/relief tiles from an MBTiles cache, rendering missing tiles on demand and masking out land.",
  "main": "plugin/index.js",
  "scripts": {
    "build": "tsc",
    "watch": "tsc -w",
    "build-land-db": "node tools/build-land-db.js",
    "prepare": "tsc"
  },
  "keywords": [
    "signalk-node-server-plugin",
    "signalk",
    "signalk-category-chart-plotters",
    "chart",
    "noaa",
    "bluetopo",
    "bathymetry",
    "sonar",
    "mbtiles"
  ],
  "author": "Joel Kozikowski",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "adm-zip": "^0.5.16",
    "better-sqlite3": "^11.10.0",
    "sharp": "^0.34.0",
    "shapefile": "^0.6.6"
  },
  "devDependencies": {
    "@signalk/server-api": "^2.10.1",
    "@types/adm-zip": "^0.5.7",
    "@types/better-sqlite3": "^7.6.11",
    "@types/express": "^4.17.21",
    "@types/node": "^20.11.0",
    "typescript": "^5.4.0"
  }
}
